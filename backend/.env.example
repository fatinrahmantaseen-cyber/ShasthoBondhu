# Environment Settings
# In production, set ENVIRONMENT=production and DEBUG=False
ENVIRONMENT=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# CORS Configuration (Allowed frontend origins, JSON array or comma-separated format)
# In production, ONLY explicit https:// domains are allowed (e.g. ["https://shasthobondhu.com", "https://admin.shasthobondhu.com"])
# Wildcards ('*') and localhost/127.0.0.1 origins are rejected in production mode.
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:3001", "http://127.0.0.1:3001"]

# Allowed Hosts for Host Header Validation (JSON array or comma-separated format)
# In production, specify explicit domain names (e.g. ["shasthobondhu.com", "api.shasthobondhu.com"])
ALLOWED_HOSTS=["localhost", "127.0.0.1", "testserver"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=shasthobondhu

# SQLAlchemy Database Connection URL (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/shasthobondhu

# Application-Level Phone Encryption Key (Fernet 32-byte url-safe base64 key)
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DONOR_PHONE_ENCRYPTION_KEY=replace_with_fernet_key_here

# Administrator Authentication Configuration
# Generate a secure PBKDF2 hash with: python -m app.scripts.generate_admin_hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$replace_with_salt_hex$replace_with_hash_hex
# High-entropy signing secret for admin tokens (e.g. 32-byte urlsafe token)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET_KEY=replace_with_high_entropy_signing_secret_here
ADMIN_TOKEN_EXPIRE_MINUTES=120


